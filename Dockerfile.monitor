# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/signalwatch/ ./cmd/signalwatch/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -o /out/signalwatch ./cmd/signalwatch
RUN mkdir -p /out/state && chown 10001:10001 /out/state && chmod 0700 /out/state

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/signalwatch /signalwatch
# A fresh named volume inherits this directory ownership from this image.
COPY --from=build --chown=10001:10001 /out/state /state
USER 10001:10001
ENTRYPOINT ["/signalwatch"]
CMD ["--sources-dir", "/sources", "--state-dir", "/state"]
