# Copy to .env.tunnel.local in the repository root (ignored by Git).
# Set these only when ready to connect to a real OpenAI Tunnel.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Host directory, mounted read-only at /sources inside the container.
# The bundled example supports discovery, but example.com/news is not a real feed.
SIGNALWATCH_SOURCES_DIR=./examples/sources
